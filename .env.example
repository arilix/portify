# Application
APP_NAME=Portify
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://IP_PUBLIK_VM

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# MySQL internal Docker tanpa SSL
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=portify
DB_USERNAME=portify
DB_PASSWORD=ganti-password-database
MYSQL_ROOT_PASSWORD=ganti-password-root

# Laravel runtime
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Container startup
RUN_MIGRATIONS=true
RUN_SEEDERS=true
SEEDER_CLASS=TemplateSeeder
DB_WAIT_RETRIES=30
DB_WAIT_INTERVAL=2

# Mail untuk praktikum
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Integrasi opsional aplikasi
PAYMENT_MODE=demo
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

VITE_APP_NAME="${APP_NAME}"
